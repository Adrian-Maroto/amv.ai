node_modules/
# Both .build directories hold the same thing: a copy of amv-backend.js with an
# export line appended, written from source immediately before the suite imports
# it. The worker one was ignored from the start; the e2e one was not, so a single
# generated file sat in the repository and turned up as an uncommitted change
# after every edit to the Worker - noise that says nothing about the change that
# caused it, on a file nothing reads.
tests/worker/.build/
tests/e2e/.build/
/tmp/
*.log
.DS_Store

# Screenshots from tests/lib/shots.mjs - look at them, do not commit them
.shots/
.gate-pass

# Local-only secrets for `wrangler dev`. Never committed, even when the values
# are throwaway: a file that sometimes holds a real key must never be a file
# git is willing to track.
.dev.vars
.dev.vars.*

# Build state and rescue files for the index.html hand-edit guard.
# The stamp is machine-local on purpose: committing it would change on every
# build and add churn to every commit, and a fresh clone simply has no stamp
# until its first build - which the guard already treats as "nothing to compare".
.buildstamp.json
.discarded-index-*.txt
.test-run.lock
.gate.lock

# Local wrangler runtime state - the KV, the Durable Object storage and the
# caches `wrangler dev --local` writes while smoke-real.mjs drives the real
# Worker. Regenerated on every run and meaningless anywhere else, but it turned
# up as an untracked directory after each full gate, which is noise that says
# nothing about the change that caused it - the same reason tests/*/.build is
# ignored above.
.wrangler/

# A local MCP session handle (a port and a 64-hex token) that was committed by
# accident. Nothing in this repository reads it - it is scratch state from a
# dev session - and a file shaped like a credential must never be one git is
# willing to track, for the same reason .dev.vars is ignored above. It became
# a real exposure the day the static host was found to be publishing the
# repository root rather than public/.
mcp-session.txt
