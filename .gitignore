node_modules/
# Both .build directories hold the same thing: a copy of amv-backend.js with an
# export line appended, written from source immediately before the suite imports
# it. The worker one was ignored from the start; the e2e one was not, so a single
# generated file sat in the repository and turned up as an uncommitted change
# after every edit to the Worker - noise that says nothing about the change that
# caused it, on a file nothing reads.
tests/worker/.build/
tests/e2e/.build/
/tmp/
*.log
.DS_Store

# Screenshots from tests/lib/shots.mjs - look at them, do not commit them
.shots/
.gate-pass

# Local-only secrets for `wrangler dev`. Never committed, even when the values
# are throwaway: a file that sometimes holds a real key must never be a file
# git is willing to track.
.dev.vars
.dev.vars.*

# Build state and rescue files for the index.html hand-edit guard.
# The stamp is machine-local on purpose: committing it would change on every
# build and add churn to every commit, and a fresh clone simply has no stamp
# until its first build - which the guard already treats as "nothing to compare".
.buildstamp.json
.discarded-index-*.txt
.test-run.lock
.gate.lock
